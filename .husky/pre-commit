# Secret scanning pre-commit hook
# Scans staged files for common secret patterns before allowing commit

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Combined regex of secret patterns
SECRET_REGEX='AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|sk-[0-9a-zA-Z]{48}|ghp_[0-9a-zA-Z]{36}|github_pat_[0-9a-zA-Z_]{82}|xox[baprs]-[0-9a-zA-Z-]+|sk_live_[0-9a-zA-Z]{24,}|sq0atp-[0-9A-Za-z_-]{22}|BEGIN.*(PRIVATE KEY)|password\s*[:=]\s*["'"'"'][^"'"'"']+|secret\s*[:=]\s*["'"'"'][^"'"'"']+|api[_-]?key\s*[:=]\s*["'"'"'][^"'"'"']+'

FOUND_SECRETS=0

for file in $STAGED_FILES; do
  case "$file" in
    *.lock|*.png|*.jpg|*.webp|*.woff|*.woff2|.husky/pre-commit) continue ;;
  esac

  MATCHES=$(git diff --cached --diff-filter=ACM -p "$file" 2>/dev/null | grep -iE "$SECRET_REGEX" | grep "^+" | grep -v "^+++" || true)
  if [ -n "$MATCHES" ]; then
    echo "WARNING: Potential secret found in: $file"
    echo "  $MATCHES"
    echo ""
    FOUND_SECRETS=1
  fi
done

if [ "$FOUND_SECRETS" -eq 1 ]; then
  echo "Commit blocked: potential secrets detected in staged files."
  echo "If these are false positives, commit with: git commit --no-verify"
  exit 1
fi
