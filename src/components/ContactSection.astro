<style>
  .contact-section {
    margin-top: 40px;
    margin-bottom: 48px;
  }

  .contact-section h2 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .contact-text {
    font-size: 16px;
    line-height: 1.7;
    color: #1a1a1a;
    margin-bottom: 16px;
  }

  .contact-links {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: 16px;
  }

  .contact-links a {
    color: #c97070;
    text-decoration: underline;
    transition: color 0.2s;
  }

  .contact-links a:hover {
    color: #1a1a1a;
  }

  .contact-sep {
