<style>
  .coming-soon {
    color: #888;
    font-style: italic;
    padding: 48px 0;
    text-align: center;
  }

  .hero {
    margin-bottom: 48px;
  }

  .intro {
    font-size: 16px;
    line-height: 1.7;
    color: #1a1a1a;
    margin-bottom: 24px;
  }

  .intro-last {
    margin-bottom: 0;
  }

  h1 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 1px;
  }

  .subtitle {
    font-size: 16px;
    color: #737373;
  }

  .tabs {
    display: flex;
    gap: 24px;
    margin-top: 48px;
    position: relative;
  }

  .tab-indicator {
    position: absolute;
    bottom: -17px;
    height: 2px;
    background: #c97070;
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 1px;
  }

  .tab {
    background: none;
    border: none;
    font-family: inherit;
    font-size: 16px;
    color: #1a1a1a;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }

  .tab:hover {
    color: #737373;
  }

  .tab.active,
  .tab.active:hover {
    color: #c97070;
  }

  .divider {
    border: none;
    border-top: 1px solid #ddd;
    margin: 16px 0 32px;
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  .year-section {
    margin-bottom: 48px;
  }

  .year-section h2 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .posts-list {
    list-style: none;
  }

  .post-item {
    display: flex;
    align-items: baseline;
    gap: 0;
    padding: 10px 0;
  }

  .post-item::after {
    content: '';
    flex: 1;
    border-bottom: 2px dotted #ccc;
    margin: 0 8px;
    position: relative;
    top: -1px;
  }

  .post-date {
    font-size: 14px;
    color: #737373;
    order: 1;
  }

  .post-title {
    font-size: 16px;
    transition: color 0.2s;
  }

  .post-title:hover {
    color: #c97070;
  }

  .about-content {
    font-size: 16px;
    line-height: 1.75;
  }

  .about-photo {
    width: 100%;
    max-height: 360px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 24px;
  }

  .about-content p {
    margin-bottom: 16px;
  }

  .experience-heading {
    font-size: 16px;
    font-weight: 600;
    margin-top: 32px;
    margin-bottom: 24px;
  }

  .timeline {
    position: relative;
    padding-left: 24px;
    border-left: 1px solid #ddd;
  }

  .timeline-item {
    position: relative;
    padding-bottom: 32px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -30px;
    top: 9px;
    width: 12px;
    height: 12px;
    background: #c97070;
    border-radius: 50%;
  }

  .timeline-content h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .timeline-company {
    font-size: 15px;
    color: #1a1a1a;
    margin-bottom: 2px;
  }

  .timeline-date {
    font-size: 14px;
    color: #737373;
    margin-bottom: 12px;
  }

  .timeline-desc {
    font-size: 15px;
    line-height: 1.6;
    color: #1a1a1a;
  }

  .site-footer {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: 16px;
    margin-bottom: 48px;
  }

  .site-footer a {
    color: #1a1a1a;
    transition: color 0.2s;
  }

  .site-footer a:hover {
    color: #c97070;
  }

  .footer-sep {
    color: #737373;
  }
</style>

<script>
  const tabs = document.querySelectorAll('.tab');
  const panels = document.querySelectorAll('.tab-content');
  const indicator = document.querySelector('.tab-indicator') as HTMLElement;

  function moveIndicator(tab: Element) {
    const el = tab as HTMLElement;
    indicator.style.left = `${el.offsetLeft}px`;
    indicator.style.width = `${el.offsetWidth}px`;
  }

  // Set initial position
  const activeTab = document.querySelector('.tab.active');
  if (activeTab) moveIndicator(activeTab);

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');

      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));

      tab.classList.add('active');
      document.getElementById(`tab-${target}`)?.classList.add('active');
      moveIndicator(tab);
    });
  });
</script>
