---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  // Sort posts by date descending
  const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  
  return sortedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: { 
      post,
      prevPost: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
      nextPost: index > 0 ? sortedPosts[index - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} - Austin Auth`}>
  <article>
    <header class="post-header">
      <div class="post-meta">
        <span class="type">{post.data.type}</span>
        <span class="separator">//</span>
        <span class="date">{formatDate(post.data.date)}</span>
      </div>
      <h1>{post.data.title}</h1>
    </header>
    <hr class="divider" />
    {(post.data.company || post.data.timeline || post.data.role || post.data.collaborators) && (
      <div class="post-details">
        {post.data.company && (
          <div class="detail-row">
            <span class="detail-label">Company:</span>
            <span class="detail-value">{post.data.company}</span>
          </div>
        )}
        {post.data.timeline && (
          <div class="detail-row">
            <span class="detail-label">Timeline:</span>
            <span class="detail-value">{post.data.timeline}</span>
          </div>
        )}
        {post.data.role && (
          <div class="detail-row">
            <span class="detail-label">My Role:</span>
            <span class="detail-value">{post.data.role}</span>
          </div>
        )}
        {post.data.collaborators && (
          <div class="detail-row">
            <span class="detail-label">Collaborators:</span>
            <span class="detail-value">{post.data.collaborators}</span>
          </div>
        )}
      </div>
      <hr class="divider" />
    )}
    <div class="post-content">
      <Content />
    </div>
    <nav class="post-nav" aria-label="Post navigation">
      <div class="nav-prev">
        {prevPost && (
          <a href={`/posts/${prevPost.id}`}><span aria-hidden="true">←</span> {prevPost.data.title}</a>
        )}
      </div>
      <div class="nav-next">
        {nextPost && (
          <a href={`/posts/${nextPost.id}`}>{nextPost.data.title} <span aria-hidden="true">→</span></a>
        )}
      </div>
    </nav>
  </article>
  <div id="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged image" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:1000;cursor:pointer;justify-content:center;align-items:center;padding:40px;">
    <button id="lightbox-close" aria-label="Close image" style="position:absolute;top:16px;right:16px;background:none;border:none;color:#fff;font-size:32px;cursor:pointer;padding:8px;line-height:1;">&times;</button>
    <img id="lightbox-img" src="" alt="" style="max-width:90vw;max-height:90vh;object-fit:contain;border-radius:6px;" />
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var lightbox = document.getElementById('lightbox');
    var lightboxImg = document.getElementById('lightbox-img');
    var closeBtn = document.getElementById('lightbox-close');
    var lastFocused = null;

    function openLightbox(img) {
      lastFocused = document.activeElement;
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt || 'Enlarged view';
      lightbox.style.display = 'flex';
      closeBtn.focus();
    }

    function closeLightbox() {
      lightbox.style.display = 'none';
      if (lastFocused) lastFocused.focus();
    }

    document.querySelectorAll('.post-content img').forEach(function(img) {
      img.style.cursor = 'pointer';
      img.setAttribute('tabindex', '0');
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', (img.alt || 'Image') + ' — click to enlarge');
      img.addEventListener('click', function() { openLightbox(img); });
      img.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(img);
        }
      });
    });

    closeBtn.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && lightbox.style.display === 'flex') {
        closeLightbox();
      }
    });
  });
</script>

<style>
  article {
    max-width: 100%;
  }

  .post-header {
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .post-meta {
    font-size: 14px;
    color: #c97070;
    font-style: italic;
    margin-bottom: 8px;
  }

  .separator {
    margin: 0 6px;
  }

  h1 {
    font-size: 28px;
    font-weight: 500;
    line-height: 1.3;
  }

  .divider {
    border: none;
    border-top: 1px solid #d0cdc8;
    margin: 24px 0 32px;
  }

  .post-details {
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .detail-row {
    display: flex;
    font-size: 16px;
    line-height: 1.6;
  }

  .detail-label {
    color: #737373;
    width: 130px;
    flex-shrink: 0;
    font-style: italic;
  }

  .detail-value {
    color: #1a1a1a;
  }

  .post-content {
    font-size: 16px;
    line-height: 1.8;
  }

  .post-content :global(h2) {
    font-size: 20px;
    font-weight: 600;
    margin: 32px 0 16px;
  }

  .post-content :global(h3) {
    font-size: 18px;
    font-weight: 600;
    margin: 24px 0 12px;
  }

  .post-content :global(p) {
    margin-bottom: 16px;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 16px;
    padding-left: 24px;
  }

  .post-content :global(li) {
    margin-bottom: 4px;
  }

  .post-content :global(a) {
    color: #c97070;
    text-decoration: underline;
  }

  .post-content :global(a:hover) {
    color: #c97070;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid #e0ddd8;
    padding-left: 16px;
    margin: 24px 0;
    color: #666;
    font-style: normal;
  }

  .post-content :global(code) {
    background: #e8e6e2;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 14px;
  }

  .post-content :global(pre) {
    background: #2d2d2d;
    color: #f8f8f2;
    padding: 16px;
    border-radius: 6px;
    overflow-x: auto;
    margin-bottom: 16px;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }

  .post-content :global(.emphasis) {
    display: block;
    background: #e8e6e2;
    padding: 16px 20px;
    border-radius: 8px;
    font-size: 16px;
    margin: 24px 0;
  }

  .post-content :global(.emphasis > *:last-child) {
    margin-bottom: 0;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid #d0cdc8;
    margin: 32px 0;
  }

  .post-content :global(img) {
    max-width: 800px;
    width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 24px auto;
    display: block;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .post-content :global(img:hover) {
    opacity: 0.9;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0 24px;
    font-size: 14px;
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid #d0cdc8;
    padding: 6px 10px;
    text-align: left;
  }

  .post-content :global(th) {
    background: #e8e6e2;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 60px;
    padding-top: 40px;
  }

  .nav-prev,
  .nav-next {
    max-width: 45%;
  }

  .nav-prev a,
  .nav-next a {
    font-size: 14px;
    color: #c97070;
    transition: color 0.2s;
  }

  .nav-prev a:hover,
  .nav-next a:hover {
    color: #c97070;
  }

  .nav-next {
    text-align: right;
  }
</style>
