---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style>
      :root {
        --content-max-width: 740px;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: #f5f3ef;
        padding: 24px 0;
        transition: padding 0.3s ease, box-shadow 0.3s ease;
      }
      .site-header.scrolled {
        padding: 14px 0;
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
      }
      .header-inner {
        max-width: var(--content-max-width);
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .logo img {
        width: 30px;
        height: 30px;
        display: block;
        transform: rotate(30deg);
        transition: width 0.3s ease, height 0.3s ease;
      }
      .site-header.scrolled .logo img {
        width: 22px;
        height: 22px;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo" aria-label="Home">
          <img src="/leaf-2.svg" alt="" />
        </a>
        <nav class="site-nav">
          <a href="/blog">Blog</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>
    <div class="container">
      <main>
        <slot />
      </main>
    </div>
    <footer style="position: relative; width: 100%; line-height: 0; overflow: hidden; margin-top: -40px;">
      <div style="position: absolute; top: 0; left: 0; right: 0; height: 50%; background: linear-gradient(to bottom, #f5f3ef 0%, #f5f3ef 10%, rgba(245,243,239,0) 100%); z-index: 1; pointer-events: none;"></div>
      <img src="/images/garden-footer.jpg" alt="" style="width: 100%; height: 65vh; display: block; object-fit: cover; object-position: center 25%;" />
    </footer>
    <script>
      const header = document.querySelector('.site-header');
      let isScrolled = false;
      window.addEventListener('scroll', () => {
        if (!isScrolled && window.scrollY > 30) {
          isScrolled = true;
          header?.classList.add('scrolled');
        } else if (isScrolled && window.scrollY < 10) {
          isScrolled = false;
          header?.classList.remove('scrolled');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    overflow-x: clip;
  }

  html {
    font-family: 'Lora', serif;
    background-color: #f5f3ef;
    color: #1a1a1a;
  }

  body {
    min-height: 100vh;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main a:not(.post-title):not(.see-all):not(.logo) {
    color: #1a1a1a;
    text-decoration: underline;
    text-decoration-color: #c97070;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 60px 24px 0;
  }

  .site-nav {
    display: flex;
    gap: 32px;
  }

  .site-nav a {
    font-size: 14px;
    color: #666;
    transition: color 0.2s;
  }

  .site-nav a:hover {
    color: #c97070;
  }

  main {
    padding-bottom: 20px;
  }
</style>
