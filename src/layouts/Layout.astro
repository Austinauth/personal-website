---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import gardenFooter from '../assets/garden-footer.jpg';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Austin Auth — Senior Product Designer at Microsoft, building AI tools for developers.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const posts = await getCollection('posts');
const hasBlogPosts = posts.some((post) => post.data.type === 'Blog' && !post.data.draft);
const hasProjects = posts.some((post) => post.data.type === 'Project' && !post.data.draft);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Austin Auth" href={`${import.meta.env.BASE_URL}/rss.xml`} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style>
      :root {
        --content-max-width: 700px;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: #f5f3ef;
        padding: 24px 0;
        transition: padding 0.3s ease, box-shadow 0.3s ease;
      }
      .site-header.scrolled {
        padding: 14px 0;
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
      }
      .header-inner {
        max-width: var(--content-max-width);
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .logo img {
        width: 30px;
        height: 30px;
        display: block;
        transform: rotate(30deg);
        transition: width 0.3s ease, height 0.3s ease;
      }
      .site-header.scrolled .logo img {
        width: 22px;
        height: 22px;
      }
      .skip-link {
        position: absolute;
        top: -100%;
        left: 16px;
        z-index: 200;
        padding: 8px 16px;
        background: #1a1a1a;
        color: #f5f3ef;
        border-radius: 4px;
        font-size: 14px;
        text-decoration: none;
      }
      .skip-link:focus {
        top: 8px;
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="site-header">
      <div class="header-inner">
        <a href={`${import.meta.env.BASE_URL}/`} class="logo" aria-label="Home">
          <img src={`${import.meta.env.BASE_URL}/leaf-2.svg`} alt="" />
        </a>
      </div>
    </header>
    <div class="container">
      <main id="main-content">
        <slot />
      </main>
    </div>
    <footer style="position: relative; width: 100%; line-height: 0; overflow: hidden; margin-top: -40px;">
      <div style="position: absolute; top: 0; left: 0; right: 0; height: 50%; background: linear-gradient(to bottom, #f5f3ef 0%, #f5f3ef 10%, rgba(245,243,239,0) 100%); z-index: 1; pointer-events: none;"></div>
      <Image src={gardenFooter} alt="" width={1600} format="webp" quality={75} style="width: 100%; height: 65vh; display: block; object-fit: cover; object-position: center 25%;" loading="lazy" />
    </footer>
    <script>
      const header = document.querySelector('.site-header');
      let isScrolled = false;
      window.addEventListener('scroll', () => {
        if (!isScrolled && window.scrollY > 30) {
          isScrolled = true;
          header?.classList.add('scrolled');
        } else if (isScrolled && window.scrollY < 10) {
          isScrolled = false;
          header?.classList.remove('scrolled');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    overflow-x: clip;
  }

  html {
    font-family: 'Lora', serif;
    background-color: #f5f3ef;
    color: #1a1a1a;
  }

  body {
    min-height: 100vh;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .accent {
    color: #c97070;
  }

  main a:not(.post-title):not(.see-all):not(.logo) {
    color: #1a1a1a;
    text-decoration: underline;
    text-decoration-color: #c97070;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .container {
    max-width: var(--content-max-width);
    width: 100%;
    margin: 0 auto;
    padding: 60px 24px 60px;
    flex: 1;
  }

  .site-nav {
    display: flex;
    gap: 32px;
  }

  .site-nav a {
    font-size: 14px;
    color: #555;
    transition: color 0.2s;
  }

  .site-nav a:hover {
    color: #c97070;
  }

  main {
    padding-bottom: 20px;
  }

  /* Focus styles */
  :focus-visible {
    outline: 2px solid #c97070;
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Screen reader only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Respect reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
